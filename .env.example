PROJECT_ID=xiaonan_xiuxian
PROJECT_NAME=晓楠修仙
PROJECT_DEBUG=false
PROJECT_TIMEZONE=Asia/Shanghai
PROJECT_DOMAIN=

SERVER_HOST=0.0.0.0
SERVER_PORT=8845
SERVER_RELOAD=false
SERVER_SSL_CERTFILE=
SERVER_SSL_KEYFILE=

DATABASE_PATH=database/game.db
RUNTIME_LOG_DATABASE_PATH=database/runtime_log.db
DATABASE_BUSY_TIMEOUT_MS=5000

LOG_LEVEL=INFO
LOG_COLOR=auto
LOG_DIR=log
LOG_FILE=log/runserver.log
LOG_ROTATION=12:00
LOG_RETENTION=3 days
LOG_COMPRESSION=zip

ROUTER_MODULE_GROUPS=[]
ROUTER_MODULES=["game.app"]
# 需要启用公式兼容性测试时，追加："公式预览"
ROUTER_FOLDERS=["game.cmd"]
ROUTER_GROUPS=[]
ROUTER_CHILD_FOLDERS=[]

# QQ 入站传输：webhook（默认，开放平台回调）| websocket（网关长连接）| both。
# 两种入站共用同一份命令表与回复链路，both 只在迁移或对照调试时使用。
QQ_TRANSPORT=webhook
# 留空时通过 /gateway/bot 获取网关地址；填写后直接使用该地址（本地回环验证用）。
QQ_WS_GATEWAY_URL=
# 订阅的事件位：intent 名字列表，或一个十进制整数。默认群/单聊消息 + 互动事件。
QQ_WS_INTENTS=["GROUP_AND_C2C_EVENT","INTERACTION"]

QQ_EVENT_PATH=/qq/events
QQ_EVENT_SIGNATURE_REQUIRED=false
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
QQ_BOT_NAME=

# 天道管理台用户名固定为“天道”；部署时为这里设置独立密码。
WEB_CONSOLE_PASSWORD=
