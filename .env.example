PROJECT_ID=xiaonan_xiuxian
PROJECT_NAME=晓楠修仙
PROJECT_DEBUG=false
PROJECT_TIMEZONE=Asia/Shanghai
PROJECT_DOMAIN=

SERVER_HOST=0.0.0.0
SERVER_PORT=8845
SERVER_RELOAD=false
SERVER_SSL_CERTFILE=
SERVER_SSL_KEYFILE=

DATABASE_PATH=database/game.db
RUNTIME_LOG_DATABASE_PATH=database/runtime_log.db
DATABASE_BUSY_TIMEOUT_MS=5000

LOG_LEVEL=INFO
LOG_COLOR=auto
LOG_DIR=log
LOG_FILE=log/runserver.log
LOG_ROTATION=12:00
LOG_RETENTION=3 days
LOG_COMPRESSION=zip

ROUTER_MODULE_GROUPS=[]
ROUTER_MODULES=["game.app"]
# 需要启用公式兼容性测试时，追加："公式预览"
ROUTER_FOLDERS=["game.cmd"]
ROUTER_GROUPS=[]
ROUTER_CHILD_FOLDERS=[]

QQ_EVENT_PATH=/qq/events
QQ_EVENT_SIGNATURE_REQUIRED=false
QQ_BOT_APP_ID=
QQ_BOT_SECRET=
QQ_BOT_NAME=

# 天道管理台用户名固定为“天道”；部署时为这里设置独立密码。
WEB_CONSOLE_PASSWORD=
